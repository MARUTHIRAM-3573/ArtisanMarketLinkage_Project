{
  "name": "artisan-platform-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Artisan Digital Commerce Platform — React Native + Expo mobile app (Android-first, per docs/architecture/13_FRONTEND_DASHBOARD_PLAN.md).",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "build": "eas build --platform android --non-interactive",
    "preview": "expo start --no-dev --minify",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-av": "~14.0.7",
    "expo-image-picker": "~15.0.7",
    "expo-secure-store": "~13.0.2",
    "expo-crypto": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "axios": "^1.7.7",
    "@tanstack/react-query": "^5.59.0",
    "zustand": "^4.5.5",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.8",
    "@hookform/resolvers": "^3.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^13.0.0",
    "prettier": "^3.3.3",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "18.2.0",
    "@testing-library/react-native": "^12.7.2"
  },
  "private": true
}
