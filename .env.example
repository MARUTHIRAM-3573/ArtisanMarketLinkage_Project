# =========================================================================
# Artisan Digital Commerce Platform — Environment Variable Reference
# Copy this file to .env.local and fill in real values. NEVER commit .env.local
# or any file containing real secrets (source principle #33.10).
# No Vault/secrets-manager is used for MVP (ADR-10) — plain env vars only.
# =========================================================================

# ---- Database (used by: backend/app, all 11 domain modules, database/migrations) ----
DB_HOST=postgres                          # hostname of the PostgreSQL service (docker-compose service name locally)
DB_PORT=5432                              # PostgreSQL port
DB_NAME=artisan_marketplace               # database name (source §5)
DB_USERNAME=artisan                       # DB role used by the backend
DB_PASSWORD=artisan_dev_password          # DEV ONLY placeholder — never a real password in this file

# ---- Auth / JWT (used by: backend/modules/auth, backend/common/security, frontend/src/store/auth.ts) ----
JWT_SECRET=dev-only-change-me-dev-only-change-me   # HMAC signing key — MUST be replaced with a strong random secret outside local dev
JWT_ACCESS_TOKEN_TTL_MINUTES=30           # Access token lifetime (PROPOSED default, see docs/architecture/08_SECURITY_AND_VAULT.md Part C.1)
JWT_REFRESH_TOKEN_TTL_DAYS=14             # Refresh token lifetime (PROPOSED default)

# ---- AI provider (used by: backend/modules/ai) ----
# Exact AI provider is an open question (docs/architecture/02_ARCHITECTURE_OVERVIEW.md §4) —
# the adapter interface is provider-agnostic; set whichever concrete provider's credentials here once chosen.
AI_PROVIDER_API_KEY=dev-placeholder-key
AI_PROVIDER_BASE_URL=https://example-ai-provider.invalid/v1

# ---- Media storage (used by: backend/modules/media) ----
MEDIA_STORAGE_PROVIDER=LOCAL              # LOCAL | S3 | OTHER — LOCAL for MVP (source §5, §12)
MEDIA_STORAGE_LOCAL_PATH=/app/uploads     # Path inside the backend container where uploads are written
MEDIA_MAX_UPLOAD_SIZE_MB=25               # Server-side upload size validation (principle #32.5) — PROPOSED default

# ---- Payment (used by: backend/modules/payment) ----
PAYMENT_GATEWAY_MODE=MOCK                 # MOCK for MVP (source §22) — never set to a real mode without a real gateway integration
PAYMENT_GATEWAY_API_KEY=dev-placeholder-key

# ---- Backend server (used by: backend/app) ----
SERVER_PORT=8080                          # Single backend deployable's HTTP port (modular monolith — one port, not one per domain)
SPRING_PROFILES_ACTIVE=local              # local | staging | prod

# ---- Frontend (used by: frontend/.env, read via Expo's process.env.EXPO_PUBLIC_*) ----
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1   # Android emulator loopback to the host backend — see docs/onboarding.md

# ---- CI/CD (used by: .github/workflows/*) ----
# These are configured as GitHub Actions repository secrets, NOT in this file —
# listed here only so the full variable surface is documented in one place.
# GHCR_TOKEN, ANDROID_KEYSTORE_BASE64, EAS_TOKEN
